{
  "name": "@yunttopia/agent-guardrails",
  "version": "0.1.0",
  "description": "Guardrails for tool-using LLM agents: budget-capped model adapter, hash-chained event log, durable task queue and step journal, risk ranks and signed approval tokens.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./model": "./dist/model/index.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/google": "4.0.99",
    "@ai-sdk/openai": "4.0.96",
    "@ai-sdk/provider": "4.0.29",
    "better-sqlite3-multiple-ciphers": "13.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
